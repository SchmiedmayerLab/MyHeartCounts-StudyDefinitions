            "display": "Yes, I work 4 days per week"
          }
        },
        {
          "valueCoding": {
            "code": "yes-i-work-5-days-per-week",
            "system": "urn:uuid:e3fef34a-213d-4297-83f8-7beae03b9210",
            "display": "Yes, I work 5 days per week"
          }
        },
        {
          "valueCoding": {
            "code": "yes-i-work-6-days-per-week",
            "system": "urn:uuid:e3fef34a-213d-4297-83f8-7beae03b9210",
