          }
        }
      ]
    },
    {
      "linkId": "5ce1f8e8-783e-4363-9ff6-9bfff63a5009",
      "type": "time",
      "text": "On Workdays:\n\nWhat time do you wake up?"
    },
    {
      "linkId": "268e4249-3302-4304-9066-ca38846a1f5f",
      "type": "quantity",
      "text": "On Workdays:\n\nHow long do you lay in bed before getting up?",
      "extension": [
