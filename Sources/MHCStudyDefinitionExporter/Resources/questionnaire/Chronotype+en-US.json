    {
      "linkId": "ce0c3deb-9e1c-4e6b-8477-e33f7072868f",
      "type": "time",
      "text": "On Free Days:\n\nWhat time do you go to bed?"
    },
    {
      "linkId": "fc140de3-5616-425e-e77f-bad0f013089f",
