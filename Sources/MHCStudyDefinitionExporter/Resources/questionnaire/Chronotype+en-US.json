          }
        }
      ]
    },
    {
      "linkId": "1143f26f-2f5b-4761-8091-16664817643b",
      "type": "time",
      "text": "On Workdays:\n\nWhat time do you go to bed?"
    },
    {
      "linkId": "9ae1c52d-f740-44d5-a21d-17ec36fe419a",
      "type": "time",
      "text": "On Workdays:\n\nWhat time do you actually get ready to fall asleep?\n(Note that some people stay awake for some time when in bed!)"
    },
    {
      "linkId": "90bed2c0-e4fc-4def-8708-f8376eaf7eba",
      "type": "quantity",
      "text": "On Workdays:\n\nHow many minutes do you need to fall asleep?",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unitOption",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
