  "item": [
    {
      "linkId": "90cb3e9c-71f6-4a48-8fca-47776be52a99",
      "type": "display",
      "text": "Munich ChronoType Questionnaire (MCTQ)\n\nIn this questionnaire, you report on your typical sleep behaviour over the past 4 weeks. We ask about work days and work-free days separately. \n\nPlease respond to the questions according to your perception of a standard week that includes your usual work days and work-free days."
    },
    {
      "linkId": "d72d3ae1-c684-415c-8155-6d2edac7f957",
      "type": "choice",
      "text": "Do you have a regular work schedule? (this includes being, for example, a housewife or househusband)\n\nIf your answer “Yes, on 7 days” or “No”, please consider if your sleep times may nonetheless differ between regular ‘workdays’ and ‘weekend days’ and fill out the MCTQ in this respect.",
      "answerOption": [
        {
          "valueCoding": {
            "code": "yes-i-work-1-day-per-week",
            "system": "urn:uuid:e3fef34a-213d-4297-83f8-7beae03b9210",
            "display": "Yes, I work 1 day per week"
          }
        },
        {
          "valueCoding": {
            "code": "yes-i-work-2-days-per-week",
            "system": "urn:uuid:e3fef34a-213d-4297-83f8-7beae03b9210",
            "display": "Yes, I work 2 days per week"
          }
        },
        {
          "valueCoding": {
            "code": "yes-i-work-3-days-per-week",
            "system": "urn:uuid:e3fef34a-213d-4297-83f8-7beae03b9210",
            "display": "Yes, I work 3 days per week"
          }
        },
        {
